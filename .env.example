# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string. If unset, falls back to local SQLite (society.db).
DATABASE_URL=

# Enables AI-assisted PDF/Excel parsing (see aiParser.js). Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Offsite backup destinations (see backupService.js) — every backup uploads
# a JSON snapshot outside the app's own database, so it survives even if
# the Postgres database itself is lost.

# Railway object storage bucket (S3-compatible). Get these from
# `railway bucket credentials --bucket <name> --json` after creating one
# with `railway bucket create <name> --region <region>`.
BACKUP_BUCKET_ENDPOINT=
BACKUP_BUCKET_ACCESS_KEY=
BACKUP_BUCKET_SECRET_KEY=
BACKUP_BUCKET_NAME=
BACKUP_BUCKET_REGION=auto

# Email delivery via Resend's HTTP API (not SMTP — Railway blocks/throttles
# outbound SMTP, and Gmail tends to reject connections from shared cloud IP
# ranges). Get a key at https://resend.com/api-keys (free tier, no card).
RESEND_API_KEY=
BACKUP_EMAIL_TO=
# Optional — defaults to Resend's no-verification-needed sender.
BACKUP_EMAIL_FROM=
