# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string. If unset, falls back to local SQLite (society.db).
DATABASE_URL=

# Enables AI-assisted PDF/Excel parsing (see aiParser.js). Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
